# vLLM OpenAI-Compatible API Configuration

# The base URL for the vLLM server
VLLM_BASE_URL=http://<YOUR-DGX-IP-OR-LOCALHOST>:8000/v1

# The API key for the vLLM server (replace with your actual key in .env)
VLLM_API_KEY=<YOUR_API_KEY_HERE>

# The model name loaded in the vLLM server
VLLM_MODEL=qwen3.8-27b
